# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sevenstar_pos
DB_POOL_MAX=10

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS origin for the React dev server
CORS_ORIGIN=http://localhost:5173

# Business
TIMEZONE=Asia/Karachi
UPLOAD_DIR=./uploads
